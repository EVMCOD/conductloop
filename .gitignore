.venv/
data/
logs/
__pycache__/
*.pyc
.DS_Store
.env
# Local (personal) config — never ship these in the market build
projects.local.json
config.json
config_urls.json
# Personal content (your own playbooks / notes) — keep out of the shipped build
playbook/*.md
TRACKER_v2.md
dist/
build/

# Desktop / Tauri wrapper
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/resources/
# (PyInstaller sidecar binaries, ~684 MB, regenerable with ./desktop/build-app.sh)
desktop-demo/node_modules/
desktop-demo/src-tauri/target/

# DB backups (regenerable snapshots — keep out of git)
backups/

tests/__pycache__/
*.pyc
.pytest_cache/

# Coverage
.coverage
htmlcov/

# Python packaging build metadata (generated by pip install / setuptools)
*.egg-info/

# ──────────────────────────────────────────────────────────────
# Public-readiness hardening (2026-10). Never commit secrets, local data,
# signing material or build output. Templates stay tracked via the
# negations below.
# ──────────────────────────────────────────────────────────────

# Environment / secrets
.env*
!.env.example
*.secret
.dev.vars
.secret.key
secrets/
credentials*.json
service-account*.json

# Signing / updater / Apple keys (Tauri minisign, Developer ID, notarization)
*.key
*.key.pub.bak
*.pem
*.p8
*.p12
*.pfx
*.cer
*.mobileprovision
*.provisionprofile
.conductloop-keys/
.tauri/

# Local databases and dumps (may contain real vault / user data)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.dump
*.sql.gz
*.cbundle
snapshots/
backups/

# Logs
logs/
*.log

# Python build artefacts
*.egg-info/
.mypy_cache/
.ruff_cache/

# Tauri / Node build output
node_modules/
**/src-tauri/target/
**/src-tauri/gen/
*.dmg
*.app/
*.app.tar.gz
*.app.tar.gz.sig

# OS / editor noise
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
*.swp

# Maintainer-only release identity (see scripts/release.local.env.example)
scripts/release.local.env

# Maintainer's local data, never published: project playbooks (they are your
# own notes; ops_dashboard/indexers/playbook.py reads ./playbook if present),
# the internal tracker / changelog and old internal release notes.
playbook/
TRACKER_v2.md
CHANGELOG.internal.md
scripts/seed-playbook.py
releases/

# Virtualenvs, also when .venv is a symlink (".venv/" only matches directories).
.venv
venv
