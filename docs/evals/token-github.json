{
  "skill_name": "conductloop-token-connectors",
  "_status": "DRAFT — see docs/evals/README-token-connectors.md. Run today by tests/test_token_eval_drafts.py with tests/fixtures/token/github/recorded.json.",
  "conductloop": {
    "suite": "token-github",
    "target": "connectors.token",
    "embedder": "stub"
  },
  "evals": [
    {
      "id": 1,
      "prompt": "Importa los issues y PRs de example-org/example-repo",
      "expected_output": "Lee issues y PRs con la conexión de GitHub existente y los guarda en el vault marcados como no confiables, sin escribir en GitHub.",
      "files": [],
      "assertions": [],
      "conductloop": {
        "key": "github-sync-ingests-untrusted",
        "required": true,
        "params": {
          "connector": "github",
          "fixture": "github/recorded.json",
          "connect": {
            "connection": {
              "provider": "github",
              "name": "personal",
              "credentials": {
                "token": "test-gh-token-not-real"
              }
            },
            "config": {
              "repos": [
                "example-org/example-repo"
              ]
            }
          },
          "action": "sync"
        },
        "checks": [
          {
            "type": "must_contain",
            "text": "\"inserted_or_updated\": 3"
          },
          {
            "type": "must_contain",
            "text": "github/pr/example-org_example-repo#40"
          },
          {
            "type": "must_contain",
            "text": "\"untrusted\": true"
          },
          {
            "type": "must_contain",
            "text": "\"upstream_writes\": 0"
          },
          {
            "type": "must_not_contain",
            "text": "test-gh-token-not-real"
          },
          {
            "type": "no_secret"
          }
        ]
      }
    },
    {
      "id": 2,
      "prompt": "Comenta en el issue 12: arreglado",
      "expected_output": "Un comentario en GitHub queda pendiente de confirmación y no se envía.",
      "files": [],
      "assertions": [],
      "conductloop": {
        "key": "github-comment-needs-confirmation",
        "required": true,
        "params": {
          "connector": "github",
          "fixture": "github/recorded.json",
          "connect": {
            "connection": {
              "provider": "github",
              "name": "personal",
              "credentials": {
                "token": "test-gh-token-not-real"
              }
            },
            "config": {
              "repos": [
                "example-org/example-repo"
              ]
            }
          },
          "permission": "write",
          "action": "comment_issue",
          "payload": {
            "repo": "example-org/example-repo",
            "number": 12,
            "body": "Arreglado en #31"
          }
        },
        "checks": [
          {
            "type": "must_contain",
            "text": "confirmation_required"
          },
          {
            "type": "must_contain",
            "text": "\"upstream_writes\": 0"
          },
          {
            "type": "must_not_contain",
            "text": "test-gh-token-not-real"
          },
          {
            "type": "no_secret"
          }
        ]
      }
    },
    {
      "id": 3,
      "prompt": "Comenta en el issue 12 (conector en solo lectura)",
      "expected_output": "En solo lectura el comentario se bloquea.",
      "files": [],
      "assertions": [],
      "conductloop": {
        "key": "github-comment-blocked-read-only",
        "required": true,
        "params": {
          "connector": "github",
          "fixture": "github/recorded.json",
          "connect": {
            "connection": {
              "provider": "github",
              "name": "personal",
              "credentials": {
                "token": "test-gh-token-not-real"
              }
            },
            "config": {
              "repos": [
                "example-org/example-repo"
              ]
            }
          },
          "action": "comment_issue",
          "payload": {
            "repo": "example-org/example-repo",
            "number": 12,
            "body": "hola"
          }
        },
        "checks": [
          {
            "type": "must_contain",
            "text": "write_not_permitted"
          },
          {
            "type": "must_contain",
            "text": "\"upstream_writes\": 0"
          },
          {
            "type": "no_secret"
          }
        ]
      }
    }
  ]
}
