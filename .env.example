# ConductLoop environment variables
#
# Copy this file to `.env` and fill in what you need. `make index`, `make serve`
# and the other make targets load `.env` automatically; when running
# `python -m ops_dashboard …` directly, export the variables yourself
# (e.g. `set -a; . ./.env; set +a`). `.env` is gitignored: never commit it.

# ============================================================
# Identity / branding (keeps the app free of personal data)
# ============================================================
# Name used in agent system prompts ("...in <owner>'s ops organization").
OPS_OWNER_NAME=the operator

# ============================================================
# Local content sources (all optional; empty = nothing indexed)
# ============================================================
# Root of the knowledge vault to index (markdown). Default: ~/Documents/vault
OPS_VAULT_ROOT=
# Workspace dir for memory files (MEMORY.md, AGENTS.md, ...). Default: ~/.ops-workspace
OPS_WORKSPACE=
# Skills dir. Default: <OPS_VAULT_ROOT>/skills
OPS_SKILLS_DIR=
# Repos to index: space/comma-separated basenames under ~ or OPS_WORKSPACE.
# If empty, derived from repo_paths in projects.local.json.
OPS_REPOS=
# JSON file with the project registry. Default: ./projects.local.json
OPS_PROJECTS_FILE=
# JSON file with live URLs to monitor (list of {name,url,project,kind}).
OPS_LIVE_URLS_FILE=

# ============================================================
# Model provider (BYOK) — or set the key from the UI (keychain)
# ============================================================
# BRAIN_PROVIDER=auto        # anthropic | openai | minimax | gateway | ollama | mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ============================================================
# Remote access (optional)
# ============================================================
# Extra Host/Origin allowed when you reach the server through a tunnel or a
# reverse proxy (the default is loopback only).
# OPS_DASHBOARD_BASE_URL=https://your-dashboard.example.com
# OPS_ALLOWED_ORIGINS=
